pipeline {
    agent any

    stages {

        stage('Check Python') {
            steps {
                bat '''
                    echo ==============================
                    echo Checking Python
                    echo ==============================

                    where py
                    py --version
                    py -m pip --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                    echo ==============================
                    echo Installing Dependencies
                    echo ==============================

                    py -m pip install --upgrade pip
                    py -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                bat '''
                    echo ==============================
                    echo Running Tests
                    echo ==============================

                    py -m pytest
                '''
            }
        }

        stage('Build') {
            steps {
                bat '''
                    echo ==============================
                    echo Build
                    echo ==============================

                    echo Build completed successfully!
                '''
            }
        }
    }

    post {
        success {
            echo "BUILD SUCCESSFUL!"
        }

        failure {
            echo "BUILD FAILED!"
        }
    }
}